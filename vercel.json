{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/finalize-post.py": {
      "maxDuration": 60,
      "includeFiles": "assets/fonts/**",
      "excludeFiles": "{posts/**,p/**,_archive_legacy/**,.github/**,*.md,*.html,sitemap.xml,robots.txt,ads.txt,og-image.png,trend_crawler.py,trend_pipeline.py,gov24_client.py,policy_crawler.py,threads_publisher.py,scorecard.py,generate_static_posts.py,generate_sitemap.py,_env_check.py,requirements.txt}"
    }
  },
  "redirects": [
    {
      "source": "/post.html",
      "has": [{ "type": "query", "key": "id", "value": "(?<id>.+)\\.json" }],
      "destination": "/p/:id.html",
      "permanent": true
    },
    {
      "source": "/post",
      "has": [{ "type": "query", "key": "id", "value": "(?<id>.+)\\.json" }],
      "destination": "/p/:id.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/posts/(.*)\\.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, stale-while-revalidate=300"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
